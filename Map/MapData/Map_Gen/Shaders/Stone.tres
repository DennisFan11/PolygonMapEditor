code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_3 : repeat_disable;


// SimpleNoise
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Voronoi
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Ellipse
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Constant:2
	vec3 n_out2p0 = vec3(0.500000, 0.500000, 0.500000);


	float n_out9p0;
// SimpleNoise:9
	float n_in9p1 = 5.00000;
	int n_in9p2 = 10;
	{
		n_out9p0 = simple_noise(UV, n_in9p1, n_in9p2);
	}


	float n_out7p0;
	float n_out7p1;
// Voronoi:7
	float n_in7p1 = 5.00000;
	{
		n_out7p0 = voronoi_noise_euclidean(vec2(n_out9p0), n_in7p1, n_out9p0, n_out7p1);
	}


// CurveTexture:3
	float n_out3p0 = texture(curve_frg_3, vec2(n_out7p0)).r;


	float n_out5p0;
// Ellipse:5
	float n_in5p1 = 1.00000;
	float n_in5p2 = 1.00000;
	{
		n_out5p0 = ellipse_shape(UV, n_in5p1, n_in5p2);
	}


// FloatOp:6
	float n_out6p0 = n_out3p0 * n_out5p0;


// Output:0
	COLOR.rgb = n_out2p0;
	COLOR.a = n_out6p0;


}

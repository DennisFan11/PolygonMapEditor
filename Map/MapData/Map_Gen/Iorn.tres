code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_3 : repeat_disable;
uniform sampler2D curve_frg_9 : repeat_disable;


// SimpleNoise
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Voronoi
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Ellipse
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Constant:6
	vec3 n_out6p0 = vec3(0.200000, 0.200000, 0.200000);


	float n_out12p0;
// SimpleNoise:12
	float n_in12p1 = 5.00000;
	int n_in12p2 = 10;
	{
		n_out12p0 = simple_noise(UV, n_in12p1, n_in12p2);
	}


	float n_out13p0;
	float n_out13p1;
// Voronoi:13
	float n_in13p1 = 5.00000;
	{
		n_out13p0 = voronoi_noise_euclidean(vec2(n_out12p0), n_in13p1, n_out12p0, n_out13p1);
	}


// CurveTexture:3
	float n_out3p0 = texture(curve_frg_3, vec2(n_out13p0)).r;


	float n_out7p0;
// SimpleNoise:7
	float n_in7p1 = 20.00000;
	int n_in7p2 = 6;
	{
		n_out7p0 = simple_noise(UV, n_in7p1, n_in7p2);
	}


// CurveTexture:9
	float n_out9p0 = texture(curve_frg_9, vec2(n_out7p0)).r;


// FloatOp:8
	float n_out8p0 = n_out3p0 * n_out9p0;


	float n_out10p0;
// Ellipse:10
	float n_in10p1 = 1.00000;
	float n_in10p2 = 1.00000;
	{
		n_out10p0 = ellipse_shape(UV, n_in10p1, n_in10p2);
	}


// FloatOp:11
	float n_out11p0 = n_out8p0 * n_out10p0;


// Output:0
	COLOR.rgb = n_out6p0;
	COLOR.a = n_out11p0;


}

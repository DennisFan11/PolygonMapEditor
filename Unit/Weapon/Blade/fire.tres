code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform float angle = 0;
uniform sampler2D curve_frg_30 : repeat_disable;
uniform sampler2D screen_tex_frg_11 : hint_screen_texture;


// GradientNoise
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Voronoi
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// Ellipse
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Input:9
	vec2 n_out9p0 = SCREEN_UV;


// FloatParameter:48
	float n_out48p0 = angle;


// FloatFunc:49
	float n_out49p0 = cos(n_out48p0);


// FloatFunc:50
	float n_out50p0 = sin(n_out48p0);


// VectorCompose:51
	vec2 n_out51p0 = vec2(n_out49p0, n_out50p0);


// Input:4
	vec2 n_out4p0 = UV;
	float n_out4p1 = n_out4p0.r;
	float n_out4p2 = n_out4p0.g;


// FloatOp:12
	float n_in12p1 = 10.00000;
	float n_out12p0 = n_out4p1 * n_in12p1;


// Input:3
	float n_out3p0 = TIME;


// FloatOp:13
	float n_in13p1 = 5.00000;
	float n_out13p0 = n_out3p0 * n_in13p1;


// FloatOp:5
	float n_out5p0 = n_out4p2 - n_out13p0;


// VectorCompose:7
	vec2 n_out7p0 = vec2(n_out12p0, n_out5p0);


	float n_out45p0;
// GradientNoise:45
	float n_in45p1 = 4.00000;
	{
		n_out45p0 = gradient_noise(n_out7p0, n_in45p1);
	}


// Input:36
	vec2 n_out36p0 = UV;
	float n_out36p1 = n_out36p0.r;
	float n_out36p2 = n_out36p0.g;


// FloatOp:39
	float n_in39p1 = 1.00000;
	float n_out39p0 = n_out36p1 * n_in39p1;


// Input:35
	float n_out35p0 = TIME;


// FloatOp:40
	float n_in40p1 = -0.50000;
	float n_out40p0 = n_out35p0 * n_in40p1;


// FloatOp:37
	float n_out37p0 = n_out36p2 - n_out40p0;


// VectorCompose:38
	vec2 n_out38p0 = vec2(n_out39p0, n_out37p0);


// Input:42
	float n_out42p0 = TIME;


	float n_out46p0;
	float n_out46p1;
// Voronoi:46
	float n_in46p1 = 5.00000;
	{
		n_out46p0 = voronoi_noise_euclidean(n_out38p0, n_in46p1, n_out42p0, n_out46p1);
	}


// Mix:44
	float n_in44p2 = 0.30000;
	float n_out44p0 = mix(n_out45p0, n_out46p0, n_in44p2);


// Input:23
	vec2 n_out23p0 = UV;
	float n_out23p2 = n_out23p0.g;


// FloatOp:24
	float n_in24p1 = 0.50000;
	float n_out24p0 = n_out23p2 * n_in24p1;


// CurveTexture:30
	float n_out30p0 = texture(curve_frg_30, vec2(n_out24p0)).r;


// FloatOp:10
	float n_out10p0 = n_out44p0 * n_out30p0;


// VectorOp:52
	vec2 n_out52p0 = n_out51p0 * vec2(n_out10p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out52p0 * n_in8p1 + n_out9p0;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(screen_tex_frg_11, n_out8p0);


// VectorOp:28
	vec3 n_in28p1 = vec3(1.30000, 1.00000, 1.00000);
	vec3 n_out28p0 = vec3(n_out11p0.xyz) * n_in28p1;


// Input:19
	vec2 n_out19p0 = UV;
	float n_out19p2 = n_out19p0.g;


// FloatOp:16
	float n_out16p0 = n_out44p0 * n_out19p2;


// VectorCompose:17
	float n_in17p0 = 0.00000;
	vec2 n_out17p0 = vec2(n_in17p0, n_out16p0);


// UVFunc:14
	vec2 n_in14p1 = vec2(1.00000, 1.00000);
	vec2 n_out14p0 = n_out17p0 * n_in14p1 + UV;


	float n_out47p0;
// Ellipse:47
	float n_in47p1 = 1.00000;
	float n_in47p2 = 1.50000;
	{
		n_out47p0 = ellipse_shape(n_out14p0, n_in47p1, n_in47p2);
	}


// Output:0
	COLOR.rgb = n_out28p0;
	COLOR.a = n_out47p0;


}
"
